{% set theme = config.themes.hypertext %}
{% set local = page.header.hypertext|default({}) %}
{% set header_cfg = theme.header|merge(local.header|default({})|filter(value => value != 'default')) %}
{% set footer_cfg = theme.footer|merge(local.footer|default({})|filter(value => value != 'default')) %}
{% set nav_cfg = theme.navigation|merge(local.navigation|default({})|filter(value => value != 'default')) %}
{% set layout_cfg = theme.layout|merge(local.layout|default({})|filter(value => value != 'default')) %}
{% set local_style = local.style|default({}) %}
{% set local_style_preset = local_style.preset|default('inherit') %}
{% set style_cfg = theme.style|merge(local_style|filter((value, key) => key != 'preset' and value != 'default')) %}
{% if local_style_preset != 'inherit' %}
  {% set style_cfg = style_cfg|merge({'preset': local_style_preset}) %}
{% endif %}
{% set local_content = local.content|default({})|filter(value => value != 'default') %}
{% set page_cfg = theme.content|merge(local_content) %}
{% set local_assets = local.assets|default({})|filter(value => value != 'default') %}
{% set asset_cfg = theme.assets|merge(local_assets) %}
{% set css_enabled = asset_cfg.css %}
{% set js_enabled = asset_cfg.js %}
{% set dec_left = nav_cfg.decoration == 'braced' ? '[ ' : (nav_cfg.decoration == 'angled' ? '< ' : '') %}
{% set dec_right = nav_cfg.decoration == 'braced' ? ' ]' : (nav_cfg.decoration == 'angled' ? ' >' : '') %}

<!DOCTYPE html>

{% if uri.query('headless') or page_cfg.headless %}
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}">
<head>
  <meta charset="utf-8">
  <title>{% if page.title %}{{ page.title|e('html') }} | {% endif %}{{ site.title|e('html') }}</title>
</head>
<body>
  {{ block('content') }}
</body>
</html>
{% else %}
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}">
<head>
{% block head %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href="{{ page.url(true, true) }}">

  {% for meta in page.metadata %}
    <meta {% if meta.name %}name="{{ meta.name|e('html_attr') }}" {% endif %}{% if meta.http_equiv %}http-equiv="{{ meta.http_equiv|e('html_attr') }}" {% endif %}{% if meta.charset %}charset="{{ meta.charset|e('html_attr') }}" {% endif %}{% if meta.property %}property="{{ meta.property|e('html_attr') }}" {% endif %}{% if meta.content %}content="{{ meta.content|e('html_attr') }}" {% endif %}>
  {% endfor %}

  <title>{% if page.title %}{{ page.title|e('html') }} | {% endif %}{{ site.title|e('html') }}</title>

  {% set uploaded_favicon = media['image://favicon.png']|default(null) %}
  <link rel="icon" type="image/png" href="{{ uploaded_favicon ? uploaded_favicon.url : url('theme://images/favicon.png') }}">

  {% include 'partials/page/js-css.html.twig' %}
{% endblock %}
</head>

<body class="{{ page.template|e('html_attr') }}{% if page.header.bodyClasses %} {{ page.header.bodyClasses|e('html_attr') }}{% endif %}">
  <header>
  {% block header %}
    {% include 'partials/page/header.html.twig' %}
  {% endblock %}
  </header>

  <main>
    {% block item_head %}
      {% include 'partials/item/header.html.twig' with {'cfg': page_cfg} %}
    {% endblock %}

    {% block content %}
    <article>
      {{ page.content|raw }}
    </article>
    {% endblock %}

    {% block children %}
      {% include 'partials/collection/children.html.twig' %}
    {% endblock %}

    {% block item_footer %}
      {% include 'partials/item/footer.html.twig' %}
    {% endblock %}
  </main>

  <footer>
  {% block footer %}
    {% include 'partials/page/footer.html.twig' %}
  {% endblock %}
  </footer>
</body>
{% endif %}
</html>
