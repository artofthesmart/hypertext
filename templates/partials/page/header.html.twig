{% if structure.header.subheader != '' %}
  {{ structure.header.subheader|raw  }}
{% else %}
  <h1><a href="{{ home_url }}">{{ site.title|e('html') }}</a></h1>
{% endif %}

{% if site.metadata.description and structure.header['use-subheader'] %}
<p class="subtitle">{{ site.metadata.description }}</p>
{% endif %}

{% block header_navigation %}
  {% include 'partials/page/navigation.html.twig' %}
{% endblock %}

{% if grav.messages.all %}
  {% include 'partials/page/messages.html.twig' %}
{% endif %}