{% set nav = nav_cfg %}
{% set nav_items = nav['custom-items']|default([]) %}
{% set inline = nav.mode|default('inline') == 'inline' %}
{% set login_enabled = config.get('plugins.login.enabled', false) and grav.user.username %}
{% set has_nav = pages.children.visible|length > 0 or nav_items|length > 0 or login_enabled %}

{% if has_nav %}
<nav aria-label="Primary">
  {% if inline %}
    {% for child in pages.children.visible %}
      <a href="{{ child.url }}"{{ (child.active or child.activeChild) ? ' class="current"' : '' }}>{{ dec_left|raw }}{{ child.menu }}{{ dec_right|raw }}</a>
      {% if nav.decoration == 'plain' and (not loop.last or nav_items|length > 0 or login_enabled) %} | {% endif %}
    {% endfor %}

    {% for item in nav_items %}
      {% set item_rel = ((item.rel|default('')) ~ (item['new-window'] ? ' noopener' : ''))|trim %}
      <a href="{{ item.href|e('html_attr') }}"
        {% if item.title %}title="{{ item.title|e('html_attr') }}"{% endif %}
        {% if item_rel %}rel="{{ item_rel|e('html_attr') }}"{% endif %}
        {% if item.offsite %}class="offsite"{% endif %}
        {% if item['new-window'] %}target="_blank"{% endif %}>{{ dec_left|raw }}{{ item.text }}{{ dec_right|raw }}</a>
      {% if nav.decoration == 'plain' and (not loop.last or login_enabled) %} | {% endif %}
    {% endfor %}

    {% if login_enabled %}
      {{ dec_left|raw }}{% include 'partials/login-status.html.twig' %}{{ dec_right|raw }}
    {% endif %}
  {% else %}
    <ul>
      {% for child in pages.children.visible %}
        <li><a href="{{ child.url }}"{{ (child.active or child.activeChild) ? ' class="current"' : '' }}>{{ child.menu }}</a></li>
      {% endfor %}
      {% for item in nav_items %}
        {% set item_rel = ((item.rel|default('')) ~ (item['new-window'] ? ' noopener' : ''))|trim %}
        <li><a href="{{ item.href|e('html_attr') }}"
          {% if item.title %}title="{{ item.title|e('html_attr') }}"{% endif %}
          {% if item_rel %}rel="{{ item_rel|e('html_attr') }}"{% endif %}
          {% if item.offsite %}class="offsite"{% endif %}
          {% if item['new-window'] %}target="_blank"{% endif %}>{{ item.text }}</a></li>
      {% endfor %}
      {% if login_enabled %}
        <li>{% include 'partials/login-status.html.twig' %}</li>
      {% endif %}
    </ul>
  {% endif %}
</nav>

{% if config.get('plugins.simplesearch.enabled', false) %}
  {% include 'partials/simplesearch_searchbox.html.twig' %}
{% endif %}

{% if config.get('plugins.breadcrumbs.enabled', false) %}
  {% include 'partials/breadcrumbs.html.twig' %}
{% endif %}

<hr>
{% endif %}
