{% set nav = structure.navigation.header %}
{% set navItems = nav['custom-items']|default([]) %}
{% set isInline = nav.mode|default('inline') == 'inline' %}
{% set navStyle = nav['text-style']|default('plain') %}
{% set decLeft = navStyle == 'braced' ? '[ ' : (navStyle == 'angled' ? '&lt; ' : '') %}
{% set decRight = navStyle == 'braced' ? ' ]' : (navStyle == 'angled' ? ' &gt;' : '') %}

{% set hasNav = pages.children.visible|length >= 1 or
                navItems|length >= 1 or
                (config.plugins.login.enabled and grav.user.username) %}

{% if hasNav %}

<nav>

  {# INLINE/TEXT NAV BAR #}
  {% if isInline %}
    {% for child in pages.children.visible %}
      <a href="{{ child.url }}"{{ (child.active or child.activeChild) ? ' class="current"' :'' }}>{{ decLeft|raw }}{{ child.menu }}{{ decRight|raw }}</a>
      {% if navStyle == 'plain' and (not loop.last or navItems|length >= 1 or (config.plugins.login.enabled and grav.user.username)) %} | {% endif %}
    {% endfor %} {# End child pages loop #}

    {# Write additional links #}
    {% if navItems|length >= 1 %}
    <span>
    {% for menuItem in navItems %}
      <a href="{{ menuItem.href }}"
        {{ menuItem.fieldset.rel ? 'rel=%s '|format(menuItem.fieldset.rel) : '' }}
        {{ menuItem.fieldset.name ? 'name=%s '|format(menuItem.fieldset.name) : '' }}
        {{ menuItem.fieldset.title ? 'title=%s '|format(menuItem.fieldset.title) : '' }}
        {{ menuItem.isOffsite ? 'class="offsite"' : '' }}
        {{ menuItem.isNewWindow ? 'target="_blank"' : '' }}>{{ decLeft|raw }}{{ menuItem.text}}{{ decRight|raw }}</a>
      {% if navStyle == 'plain' and (not loop.last or (config.plugins.login.enabled and grav.user.username)) %} | {% endif %}
    {% endfor %}
    </span>
    {% endif %} {# End additional links loop #}

    {% if config.plugins.login.enabled and grav.user.username %}
      [{% include 'partials/login-status.html.twig' %}]
    {% endif %}
  {% else %}

  {# UL/LI NAV BAR #}
  <ul>
    {% for child in pages.children.visible %}
    <li><a href="{{ child.url }}"{{ (child.active or child.activeChild) ? ' class="current"' :'' }}>{{ child.menu }}</a></li>
    {% endfor %}

    {% for menuItem in navItems %}
      <li><a href="{{ menuItem.href }}"
          {{ menuItem.rel ? 'rel="%s" '|format(menuItem.rel) : '' }}
          {{ menuItem.name ? 'name="%s" '|format(menuItem.name) : '' }}
          {{ menuItem.isOffsite ? 'class="offsite"' : '' }}
          {{ menuItem.target ? 'target="%s" '|format(menuItem.target) : '' }}
          {{ menuItem.isNewWindow ? 'target="_blank"' : '' }}>{{ menuItem.text}}</a></li>
    {% endfor %}

    {% if config.plugins.login.enabled and grav.user.username %}
      <li>[{% include 'partials/login-status.html.twig' %}]</li>
    {% endif %}
  </ul>
  {% endif %} {# End of navigation links #}

  </nav>

  {# SimpleSearch box #}
  {% if config.plugins.simplesearch.enabled ?? false %}
    {% include 'partials/simplesearch_searchbox.html.twig' %}
  {% endif %}

  {# Breadcrumbs #}
  {% if config.plugins.breadcrumbs.enabled %}
    {% include 'partials/breadcrumbs.html.twig' %}
  {% endif %}

  {# Drop in a separator as most themes need this or will hide it. #}
  <hr>
  
{% endif %} {# end if has nav #}
