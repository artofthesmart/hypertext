<hr/>
{# Write the custom footer, if available. #}
{% if structure.footer.content|default('') != '' %}
    {% if structure.footer.style|default('text') == 'text' %}
        {{ structure.footer.content|markdown }}
    {% else %}
        {{ structure.footer.content|raw }}
    {% endif %}
{% endif %}

{# Be cool; please leave the attribution in unless you really need to remove it. ;) #}
<p>{{ 'THEME_HYPERTEXT.FOOTER.BY_LINE'|t|raw }}</p>

{% block bottom %}
{% if allowJS %}
{{ assets.js('bottom')|raw }}
{% endif %}

{% if allowCSS %}
{{ assets.css('bottom')|raw }}
{% endif %}
{% endblock %}
