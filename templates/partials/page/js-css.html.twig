{% set available_styles = hypertext_styles|default({}) %}
{% set configured_style = style_cfg.preset|default('default') %}
{% set requested_style = uri.query('theme')|default('') %}
{% set stylesheet = requested_style in available_styles|keys ? requested_style : configured_style %}
{% set stylesheet = stylesheet in available_styles|keys ? stylesheet : 'default' %}
{% set style_info = available_styles[stylesheet]|default({'path': null}) %}
{% set accessible_font = style_cfg['accessible-font']|default(false) %}

{% if style_info.path %}
  <link rel="stylesheet" href="{{ url(style_info.path) }}">
{% endif %}

{% if accessible_font %}
  <link rel="preload" href="{{ url('theme://fonts/WOFF2/Atkinson-Hyperlegible-Regular-102a.woff2') }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ url('theme://fonts/WOFF2/Atkinson-Hyperlegible-Bold-102a.woff2') }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ url('theme://css/visual-impaired.css') }}">
{% endif %}

<style>
img { max-width: 100%; height: auto; }
{% if collection_cfg.layout == 'grid' %}
.children.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  gap: 1rem;
  padding: 0;
  list-style: none;
}
.children.grid > li { min-width: 0; }
{% endif %}
{% if collection_cfg.layout == 'cards' %}
.children.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  gap: 1.5rem;
}
.children.cards > article { min-width: 0; }
.children.cards figure { margin: 0 0 1rem; }
.children.cards figure > a { display: block; }
.children.cards figure img { display: block; width: 100%; }
{% endif %}
body {
{% if layout_cfg.width != 'full' %}
  max-width: {{ layout_cfg.width|int }}px;
{% endif %}
{% if layout_cfg.alignment == 'right' %}
  margin-left: auto;
  margin-right: 8px;
{% elseif layout_cfg.alignment == 'center' %}
  margin-left: auto;
  margin-right: auto;
{% else %}
  margin-left: 8px;
  margin-right: 8px;
{% endif %}
}
{{ style_cfg['custom-css']|default('')|raw }}
</style>

{% block assets deferred %}
  {% if css_enabled %}{{ assets.css()|raw }}{% endif %}
  {% if js_enabled %}{{ assets.js()|raw }}{% endif %}
{% endblock %}

{% if config.get('plugins.feed.enabled', false) %}
  <link rel="alternate" type="application/atom+xml" title="{{ site.title|e('html_attr') }} Feed" href="{{ home_url ~ '/feed:atom' }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title|e('html_attr') }} Feed" href="{{ home_url ~ '/feed:rss' }}">
{% endif %}
