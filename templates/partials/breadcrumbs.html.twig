{% set crumbs = breadcrumbs.get() %}
{% if crumbs|length > 1 %}
<nav id="breadcrumbs" aria-label="{{ 'THEME_HYPERTEXT.BREADCRUMBS'|t|default('Breadcrumb') }}">
  <ol>
    {% for crumb in crumbs %}
      <li>
        {% if not loop.last %}
          <a href="{{ crumb.url }}">{{ crumb.menu }}</a>
        {% else %}
          <strong aria-current="page">{{ crumb.menu }}</strong>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
</nav>
{% endif %}