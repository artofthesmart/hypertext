{% if not page.parent.root() and page.parent.header.content.sibling_links|default(false) %}
<p class="pagination">
  {% if not page.isLast %}
    <a href="{{ page.prevSibling.url }}">&#xab; {{ 'THEME_HYPERTEXT.PAGINATION.PREVIOUS_PAGE'|t }}</a>
  {% endif %}
  {% if not page.isFirst %}
    <a href="{{ page.nextSibling.url }}">{{ 'THEME_HYPERTEXT.PAGINATION.NEXT_PAGE'|t }} &raquo;</a>
  {% endif %}
</p>
{% endif %}
