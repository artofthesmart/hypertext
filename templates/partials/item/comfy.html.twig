{#
  partials/item/comfy.html.twig
  ─────────────────────────────
  "Comfy" list item: a more spacious summary with image beside text,
  rendered as a definition list row. No CSS overrides — layout falls
  back to browser defaults or the active stylesheet.
#}
{% set show_image = parent.header.render.children.image ?? true %}
{% set show_subtitle = parent.header.render.children.subtitle ?? true %}
{% set show_date = parent.header.render.children.date ?? false %}
{% set show_cat = parent.header.render.children.category ?? true %}

{% set header_image = page.media.images[page.header.header_image_file] ?? page.media.images|first %}
{% set use_image_crop = handling.images.resize|default(false) %}
{% set image_width  = use_image_crop ? (style.layout['content-width'] == 'default' ? 1024 : style.layout['content-width']) / 6 : header_image.width %}
{% set image_height = use_image_crop ? image_width : header_image.height %}
{% set image_url    = use_image_crop ? header_image.cropZoom(image_width, image_height).url : header_image.url %}

{% switch parent.header.render.children.which_date|default('date') %}
  {% case 'modified' %}   {% set date = page.modified %}
  {% case 'published' %}  {% set date = page.publishDate %}
  {% case 'unpublished' %}{% set date = page.unpublishDate %}
  {% default %}           {% set date = page.date %}
{% endswitch %}

{# ─────────────────────────────────────────────────────────────────────────── #}
<hr>
<article>

  {% if show_image and header_image %}
    <a href="{{ page.url }}">
      <img src="{{ image_url }}" width="{{ image_width }}" height="{{ image_height }}" loading="lazy" alt="{{ page.title|e('html_attr') }}">
    </a>
  {% endif %}

  <strong><a href="{{ page.url }}">{{ page.title }}</a></strong>
  {% if show_subtitle and page.header.subtitle %} — <small>{{ page.header.subtitle }}</small>{% endif %}

  {% if show_date %}
    <br><small><time datetime="{{ date|date('c') }}">{{ date|date(system.pages.dateformat.short) }}</time></small>
  {% endif %}

  {% if show_cat and page.taxonomy.category %}
    <br><small>
    {% for category in page.taxonomy.category %}
      <a href="{{ page.parent.url|rtrim('/') }}/category{{ config.system.param_sep }}{{ category }}">{{ category }}</a>{{ not loop.last ? ',' : '' }}
    {% endfor %}
    </small>
  {% endif %}

  {% if page.summary != page.content %}
    <p>{{ page.summary|raw }} <a href="{{ page.url }}">{{ 'THEME_HYPERTEXT.PAGINATION.CONTINUE_READING'|t }}…</a></p>
  {% else %}
    <p>{{ page.summary|raw }}</p>
  {% endif %}

</article>
