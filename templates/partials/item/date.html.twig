{#
  partials/item/date.html.twig
  ────────────────────────────
  Renders the page date with the correct type (modified, published)
  resolved through the theme, parent collection, and page override hierarchy.
#}
{% import 'partials/item/config.html.twig' as item_config %}
{% set cfg = item_config.resolve(page, parent)|json_decode %}

{% if cfg.show_date_published %}
  {% if show_label %}
    {{ 'THEME_HYPERTEXT.DATES.PUBLISHED'|t|raw }}: 
  {% endif %}
  <time datetime="{{ page.publishDate|default(page.date)|date('c') }}">{{ page.publishDate|default(page.date)|date(system.pages.dateformat.short) }}</time>
{% endif %}

{% if cfg.show_date_published and cfg.show_date_modified %}
  |
{% endif %}

{% if cfg.show_date_modified %}
  {% if show_label %}
    {{ 'THEME_HYPERTEXT.DATES.MODIFIED'|t|raw }}: 
  {% endif %}
  <time datetime="{{ page.modified|date('c') }}">{{ page.modified|date(system.pages.dateformat.short) }}</time>
{% endif %}
