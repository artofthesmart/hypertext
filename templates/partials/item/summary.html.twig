{#
  partials/item/summary.html.twig
  ───────────────────────────────
  Renders summary view of an item.
  
  Note: Global decorator variables `dec_left` and `dec_right` used here
  are dynamically registered in the theme class via `onTwigSiteVariables()`
  in `hypertext.php`.
#}
{% import 'partials/item/config.html.twig' as item_config %}
{% set cfg = item_config.resolve(page, parent)|json_decode %}
{% set inner_children = page.collection()|length > 0 ? page.collection() : page.children.visible %}

{% set thumbnail_filename = page.header.thumbnail_image_file %}
{% set thumbnail_image = page.media.images[thumbnail_filename] ??
                    media['image://' ~ thumbnail_filename] ??

                    page.media.images['thumbnail.png'] ??
                    page.media.images['thumbnail.jpg'] ??
                    page.media.images['thumbnail.gif'] ??
                    page.media.images['thumbnail.webp'] ??
                    
                    page.media.images[page.slug()~'_thumbnail.png'] ??
                    page.media.images[page.slug()~'_thumbnail.jpg'] ??
                    page.media.images[page.slug()~'_thumbnail.gif'] ??
                    page.media.images[page.slug()~'_thumbnail.webp'] ??

                    media['image://' ~ page.slug()~'_thumbnail.png'] ??
                    media['image://' ~ page.slug()~'_thumbnail.jpg'] ??
                    media['image://' ~ page.slug()~'_thumbnail.gif'] ??
                    media['image://' ~ page.slug()~'_thumbnail.webp'] ??
                    
                    page.media.images[page.header.header_image_file] ??
                    
                    page.media.images|first %}
{% set use_image_crop = (handling.images.compress|default('none') != 'none') %}
{% set image_width = use_image_crop ? (style.layout['content-width'] == 'default' ? 1024 : style.layout['content-width']) / 7 : thumbnail_image.width %}
{% set image_height = use_image_crop ? (style.layout['content-width'] == 'default' ? 1024 : style.layout['content-width']) / 7 : thumbnail_image.height %}
{% set thumbnail_image_url = use_image_crop ? thumbnail_image.cropZoom(image_width, image_height).url : thumbnail_image.url %}

{# ------------------------------------------------------------------------ #}

<hr/>
<article class="snippet{% if page.taxonomy.category %}{% for cat in page.taxonomy.category %} cat_{{ cat|hyphenize }}{% endfor %}{% endif %}">

{# Title & Subtitle #}
<h3>
  <a href="{{ page.url }}">{{ page.title }}</a>
  {% if page.header.subtitle and cfg.show_subtitle %} - <small>{{ page.header.subtitle }}</small>{% endif %}
</h3>

<p> {# The next set of items should be somewhat close together. #}

{# Image #}
{# Must be one line to avoid dangling, clickable space #}
{% if cfg.show_image and thumbnail_image %}
  <a href="{{ page.url }}"><img src="{{ thumbnail_image_url }}" width="{{ image_width }}" height="{{ image_height }}" loading="lazy" alt="{{ page.title|e('html_attr') }}"></a>
{% endif %}

{# Date #}
{% if cfg.show_date %}
{{ cfg.show_image and thumbnail_image ? '<br>' : '' }}
<sub>
    {% include 'partials/item/date.html.twig' with {'page': page, 'parent': parent, 'show_date': true} %}
</sub>
{% endif %}

{# Categories #}
{% if page.taxonomy.category and cfg.show_cat %}
<br>
  {{ 'THEME_HYPERTEXT.CATEGORIES.CATEGORIES'|t }}: <small>
  {% for category in page.taxonomy.category %}
    {{ dec_left|raw }}<a href="{{ page.parent.url|rtrim('/') }}/category{{ config.system.param_sep }}{{ category }}">{{ category }}</a>{{ dec_right|raw }}{{ not loop.last ? ',' : '' }}
  {% endfor %}</small></p>
{% else %}
{% endif %}

</p>

{# Text #}
{% if page.summary == page.content %}
  {{ page.summary|raw }}
{% else %}
  {{ page.summary|raw }}
  {% if page.header.show_clickthrough ?? true %}<p><a href="{{ page.url }}">{{ 'THEME_HYPERTEXT.PAGINATION.CONTINUE_READING'|t }}...</a></p> {% endif %}
{% endif %}

{# Children #}
{% if cfg.show_children and inner_children|length > 0 %}
{% set inner_children = inner_children.order(page.header.content.order.by|default(system.pages.order.by),
                                             page.header.content.order.dir|default(system.pages.order.dir)) %}
<p>{{ 'THEME_HYPERTEXT.PAGINATION.SUB_PAGES'|t }}:
<ol class="nested-children">
  {% for child in inner_children %}
  <li><a href="{{ child.url }}">{{ child.title }}</a>{% if cfg.show_subtitle and child.header.subtitle %} - <span><small>{{ child.header.subtitle }}</small></span>{% endif %}</li>
  {% endfor %}
</ol>
</p>
{% endif %} {# End render nested children #}

</article>
