{#
  partials/item/grid.html.twig
  ──────────────────────────
  Renders grid item view.
  
  Note: Global decorator variables `dec_left` and `dec_right` used here
  are dynamically registered in the theme class via `onTwigSiteVariables()`
  in `hypertext.php`.
#}
{% import 'partials/item/config.html.twig' as item_config %}
{% set cfg = item_config.resolve(page, parent)|json_decode %}
{% set inner_children = page.collection()|length > 0 ? page.collection() : page.children.visible %}

{% set header_image = page.media.images[page.header.header_image_file] ?? page.media.images|first %}
{% set use_image_crop = (handling.images.compress|default('none') != 'none') %}
{% set image_width = use_image_crop ? (style.layout['content-width'] == 'default' ? 1024 : style.layout['content-width']) / 7 : header_image.width %}
{% set image_height = use_image_crop ? (style.layout['content-width'] == 'default' ? 1024 : style.layout['content-width']) / 7 : header_image.height %}
{% set header_image_url = use_image_crop ? header_image.cropZoom(image_width, image_height).url : header_image.url %}

{# ------------------------------------------------------------------------ #}

<tr{% if page.taxonomy.category %} class="{% for cat in page.taxonomy.category %} cat_{{ cat|hyphenize }}{% endfor %}"{% endif %}>

  {# Image #}
  <td rowspan="3" class="image" width="20%">
  {% if cfg.show_image and header_image %}
    <a href="{{ page.url }}">
      <img src="{{ header_image_url }}" width="{{ image_width }}" height="{{ image_height }}" loading="lazy" alt="{{ page.title|e('html_attr') }}">
    </a>
  {% endif %}
  </td>
  

  {# Title #}
  <td colspan="2">
  <strong>
    <a href="{{ page.url }}">{{ page.title }}</a>
  </strong>
  </td>
</tr>

{# Subtitle #}
<tr{% if page.taxonomy.category %} class="{% for cat in page.taxonomy.category %} cat_{{ cat|hyphenize }}{% endfor %}"{% endif %}>
  <td colspan="2">
    {% if cfg.show_subtitle and page.header.subtitle %}
      {{ page.header.subtitle }}
    {% endif %}
  </td>
</tr>

<tr{% if page.taxonomy.category %} class="{% for cat in page.taxonomy.category %} cat_{{ cat|hyphenize }}{% endfor %}"{% endif %}>

{# Date #}
<td>
  {% include 'partials/item/date.html.twig' with {'page': page, 'parent': parent, 'show_date': cfg.show_date, 'show_label': true} %}
</td>

{# Categories #}
<td>
{% if page.taxonomy.category and cfg.show_cat %}
  {{ 'THEME_HYPERTEXT.CATEGORIES.CATEGORIES'|t|raw }}: 
  {% for category in page.taxonomy.category %}
    {{ dec_left|raw }}<a href="{{ page.parent.url|rtrim('/') }}/category{{ config.system.param_sep }}{{ category }}">{{ category }}</a>{{ dec_right|raw }}{{ not loop.last ? ',' : '' }}
  {% endfor %}
{% endif %}
</td></tr>

{# Children
 # Not sure how to implement this just yet...
{% if cfg.show_children and inner_children|length > 0 %}
{% set inner_children = inner_children.order(page.header.content.order.by|default('default'), page.header.content.order.dir|default('default')) %}
<br>
{{ 'THEME_HYPERTEXT.PAGINATION.SUB_PAGES'|t }}:
<ol class="nested-children">
  {% for child in inner_children %}
  <li><a href="{{ child.url }}">{{ child.title }}</a>{{ child.header.subtitle and cfg.show_subtitle ? ' - <span>'~child.header.subtitle~'</span>' : '' }}</li>
  {% endfor %}
</ol>
{% endif %} {# End render nested children #}