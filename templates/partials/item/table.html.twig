{% import 'partials/item/image.html.twig' as image %}
{% import 'partials/item/fragments.html.twig' as fragments %}
{% set content_width = layout_cfg.width == 'full' ? 960 : layout_cfg.width|int %}
{% set image_size = (content_width / 20)|round %}

<table class="children">
  <thead>
    <tr>
      {% if display_cfg.image %}<th>{{ 'THEME_HYPERTEXT.THUMBNAIL.THUMBNAIL'|t }}</th>{% endif %}
      <th>{{ 'THEME_HYPERTEXT.TITLES.TITLE'|t }}</th>
      {% if display_cfg.date != 'none' %}<th>{{ 'THEME_HYPERTEXT.DATES.DATE'|t }}</th>{% endif %}
      {% if display_cfg.categories %}<th>{{ 'THEME_HYPERTEXT.CATEGORIES.CATEGORIES'|t }}</th>{% endif %}
      {% if display_cfg.tags %}<th>{{ 'THEME_HYPERTEXT.TAGS.TAGS'|t }}</th>{% endif %}
      {% if display_cfg.summary %}<th>{{ 'THEME_HYPERTEXT.SUMMARY.SUMMARY'|t }}</th>{% endif %}
    </tr>
  </thead>
  <tbody>
  {% for child in collection if child.isPage() %}
    {% set cfg = hypertext_content_config(child, display_cfg) %}
    <tr{% if child.taxonomy.category %} class="{{ fragments.category_classes(child) }}"{% endif %}>
      {% if display_cfg.image %}
        <td>{% if cfg.image %}{{ image.render(child, 'thumbnail', image_size, image_size, 'lazy', child.url) }}{% endif %}</td>
      {% endif %}
      <td>
        {% if cfg.title %}<strong><a href="{{ child.url }}">{{ child.title }}</a></strong>{% endif %}
        {% if cfg.subtitle and child.header.subtitle %}<br><small>{{ child.header.subtitle }}</small>{% endif %}
        {% if collection_cfg.nested %}
          {% set inner_children = child.collection()|length > 0 ? child.collection() : child.children.visible %}
          {% if inner_children|length > 0 %}
            <ul>
            {% for inner in inner_children %}
              <li><a href="{{ inner.url }}">{{ inner.title }}</a></li>
            {% endfor %}
            </ul>
          {% endif %}
        {% endif %}
      </td>
      {% if display_cfg.date != 'none' %}
        <td>{% if cfg.date != 'none' %}{{ fragments.date(child, cfg.date) }}{% endif %}</td>
      {% endif %}
      {% if display_cfg.categories %}
        <td>{% if cfg.categories and child.taxonomy.category %}{{ fragments.categories(child, parent.url, dec_left, dec_right) }}{% endif %}</td>
      {% endif %}
      {% if display_cfg.tags %}
        <td>{% if cfg.tags and child.taxonomy.tag %}{{ fragments.tags(child, parent.url, dec_left, dec_right) }}{% endif %}</td>
      {% endif %}
      {% if display_cfg.summary %}
        <td>{% if cfg.summary %}{{ fragments.summary(child, cfg['read-more']) }}{% endif %}</td>
      {% endif %}
    </tr>
  {% endfor %}
  </tbody>
</table>
