{% import 'partials/item/image.html.twig' as image %}
{% import 'partials/item/fragments.html.twig' as fragments %}
{% set content_width = layout_cfg.width == 'full' ? 1024 : layout_cfg.width|int %}

{% if cfg.title and not page.home() %}
  <h2><a href="{{ page.url }}">{{ page.title }}</a></h2>
{% endif %}

{% if cfg.subtitle and page.header.subtitle %}
  <p><strong>{{ page.header.subtitle }}</strong></p>
{% endif %}

{% if cfg.image %}
  {{ image.render(page, 'header', content_width, (content_width / 5)|round, 'eager', page.url) }}
{% endif %}

{% if cfg.date != 'none' or (cfg.categories and page.taxonomy.category) or (cfg.tags and page.taxonomy.tag) %}
<p>
  {% if cfg.date != 'none' %}
    {{ 'THEME_HYPERTEXT.DATES.DATE'|t }}:
    <small>{{ dec_left|raw }}{{ fragments.date(page, cfg.date) }}{{ dec_right|raw }}</small>
  {% endif %}
  {% if cfg.categories and page.taxonomy.category %}
    {% if cfg.date != 'none' %}<br>{% endif %}
    {{ 'THEME_HYPERTEXT.CATEGORIES.CATEGORIES'|t }}:
    <small>{{ fragments.categories(page, page.parent.url, dec_left, dec_right) }}</small>
  {% endif %}
  {% if cfg.tags and page.taxonomy.tag %}
    {% if cfg.date != 'none' or (cfg.categories and page.taxonomy.category) %}<br>{% endif %}
    {{ 'THEME_HYPERTEXT.TAGS.TAGS'|t }}:
    <small>{{ fragments.tags(page, page.parent.url, dec_left, dec_right) }}</small>
  {% endif %}
</p>
{% endif %}
