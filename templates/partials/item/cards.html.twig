{#
  partials/item/cards.html.twig
  ─────────────────────────────
  Renders a single page as a self-contained card block.
  Cards are designed to sit in a CSS card/tile layout.
  Unlike grid (which uses <table> rows), each card is
  a standalone <article> that can be floated or placed
  in a CSS grid by the active stylesheet.

  Note: Global decorator variables `dec_left` and `dec_right` used here
  are dynamically registered in the theme class via `onTwigSiteVariables()`
  in `hypertext.php`.
#}
{% import 'partials/item/config.html.twig' as item_config %}
{% set cfg = item_config.resolve(page, parent)|json_decode %}

{% import 'partials/item/image.html.twig' as image_finder %}
{% set img_desc = image_finder.find_thumbnail(page)|trim %}
{% set header_image = null %}
{% if img_desc %}
  {% set parts = img_desc|split(':', 2) %}
  {% if parts[0] == 'page' %}{% set header_image = page.media.images[parts[1]] %}
  {% elseif parts[0] == 'global' %}{% set header_image = media['image://' ~ parts[1]] %}
  {% elseif parts[0] == 'first' %}{% set header_image = page.media.images|first %}
  {% endif %}
{% endif %}

{% set theme_style = config.themes.hypertext.style %}
{% set use_image_crop = (handling.images.compress|default('none') != 'none') %}
{% set image_width  = (use_image_crop and header_image) ? (theme_style.layout['content-width'] == 'default' ? 1024 : theme_style.layout['content-width']|int) / 4 : (header_image ? header_image.width : 0) %}
{% set image_height = image_width %}
{% set header_image_url = (use_image_crop and header_image) ? header_image.cropZoom(image_width, image_height).url : (header_image ? header_image.url : '') %}

{# ------------------------------------------------------------------------ #}

<article{% if page.taxonomy.category %} class="{% for cat in page.taxonomy.category %}cat_{{ cat|hyphenize }} {% endfor %}"{% endif %}>

  {% if cfg.show_image and header_image %}
    <a href="{{ page.url }}">
      <img src="{{ header_image_url }}" width="{{ image_width }}" height="{{ image_height }}" loading="lazy" alt="{{ page.title|e('html_attr') }}">
    </a>
  {% endif %}

  <strong><a href="{{ page.url }}">{{ page.title }}</a></strong>

  {% if cfg.show_subtitle and page.header.subtitle %}
    <br><small>{{ page.header.subtitle }}</small>
  {% endif %}

  {% if cfg.show_date_published or cfg.show_date_modified %}
    <br><small>
      {% 
        include 'partials/item/date.html.twig' 
        with {
          'page': page, 
          'parent': parent
        } %}
    </small>
  {% endif %}

  {% if cfg.show_cat and page.taxonomy.category %}
    <br><small>
    {% for category in page.taxonomy.category %}
      {{ dec_left|raw }}<a href="{{ page.parent.url|rtrim('/') }}/category{{ config.system.param_sep }}{{ category }}">{{ category }}</a>{{ dec_right|raw }}{{ not loop.last ? ',' : '' }}
    {% endfor %}
    </small>
  {% endif %}

</article>
