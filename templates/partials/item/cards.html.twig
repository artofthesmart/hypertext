{% import 'partials/item/image.html.twig' as image %}
{% import 'partials/item/fragments.html.twig' as fragments %}
{% set content_width = layout_cfg.width == 'full' ? 960 : layout_cfg.width|int %}
{% set image_height = (content_width * 9 / 16)|round %}

<article{% if page.taxonomy.category %} class="{{ fragments.category_classes(page) }}"{% endif %}>
  {% if cfg.image %}
    {{ image.render(page, 'thumbnail', content_width, image_height, 'lazy', page.url) }}
  {% endif %}

  {% if cfg.title %}<strong><a href="{{ page.url }}">{{ page.title }}</a></strong>{% endif %}
  {% if cfg.subtitle and page.header.subtitle %}<br><small>{{ page.header.subtitle }}</small>{% endif %}
  {% if cfg.date != 'none' %}<br><small>{{ fragments.date(page, cfg.date) }}</small>{% endif %}
  {% if cfg.categories and page.taxonomy.category %}
    <br><small>{{ fragments.categories(page, parent.url, dec_left, dec_right, config.get('system.param_sep', ':')) }}</small>
  {% endif %}
  {% if cfg.tags and page.taxonomy.tag %}
    <br><small>{{ fragments.tags(page, parent.url, dec_left, dec_right, config.get('system.param_sep', ':')) }}</small>
  {% endif %}
  {% if cfg.summary %}
    <div class="summary">{{ fragments.summary(page, cfg['read-more']) }}</div>
  {% endif %}
</article>
