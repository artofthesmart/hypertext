{#
  partials/item/list.html.twig
  ────────────────────────────
  Renders list item summary.
  
  Note: Global decorator variables `dec_left` and `dec_right` used here
  are dynamically registered in the theme class via `onTwigSiteVariables()`
  in `hypertext.php`.
#}
{% import 'partials/item/config.html.twig' as item_config %}
{% set cfg = item_config.resolve(page, parent)|json_decode %}
{% set inner_children = page.collection()|length > 0 ? page.collection() : page.children.visible %}

{# ── Image: thumbnail first, then header image fallback ──────────────────── #}
{% set thumb_url = null %}
{% set thumb_size = null %}
{% if cfg.show_image %}
  {% import 'partials/item/image.html.twig' as image_finder %}
  {% set img_desc = image_finder.find_thumbnail(page)|trim %}
  {% set thumb = null %}
  {% if img_desc %}
    {% set parts = img_desc|split(':', 2) %}
    {% if parts[0] == 'page' %}{% set thumb = page.media.images[parts[1]] %}
    {% elseif parts[0] == 'global' %}{% set thumb = media['image://' ~ parts[1]] %}
    {% elseif parts[0] == 'first' %}{% set thumb = page.media.images|first %}
    {% endif %}
  {% endif %}

  {% set theme_style = config.themes.hypertext.style %}
  {% set use_image_crop = (handling.images.compress|default('none') != 'none') %}
  {% set content_width = theme_style.layout['content-width']|default(960)|int %}
  {% set content_width = content_width == 0 ? 960 : content_width %}
  {# Thumbnail is sized relative to content width, ~6% (about 1 line height) #}
  {% set thumb_size = use_image_crop ? (content_width / 16)|round : null %}
  {% set thumb_url  = (use_image_crop and thumb_size and thumb)
      ? thumb.cropZoom(thumb_size, thumb_size).url
      : (thumb ? thumb.url : null) %}
{% endif %}

{# ------------------------------------------------------------------------ #}

{% if page.isDir() %}
<li><strong>{{ page.title }}</strong></li>
{% else %}

<li class="child-level-{{ level }}{% for cat in page.taxonomy.category %} cat_{{ cat|hyphenize }}{% endfor %}">

  {# Thumbnail #}
  {% if cfg.show_image and thumb_url %}
    <a href="{{ page.url }}">
      <img src="{{ thumb_url }}"
           {% if thumb_size %}width="{{ thumb_size }}" height="{{ thumb_size }}"{% endif %}
           loading="lazy"
           alt="{{ page.title|e('html_attr') }}">
    </a>
  {% endif %}

  {# Date #}
  {% if cfg.show_date_published or cfg.show_date_modified %}
    {{ dec_left|raw }}{% 
      include 'partials/item/date.html.twig' 
      with {
        'page': page, 
        'parent': parent
      } %}{{ dec_right|raw }}
  {% endif %}

  {# Title & Subtitle #}
  {{ level > 1 ? '' : '<strong>' }}
    <a href="{{ page.url }}">{{ page.title }}</a>
  {{ level > 1 ? '' : '</strong>' }}
  {% if page.header.subtitle and cfg.show_subtitle %} - <small>{{ page.header.subtitle }}</small>{% endif %}

  {# Categories #}
  {% if page.taxonomy.category and cfg.show_cat %}
    <br/>
    {{ 'THEME_HYPERTEXT.CATEGORIES.CATEGORIES'|t }}: <small>
    {% for category in page.taxonomy.category %}
      {{ dec_left|raw }}<a href="{{ page.parent.url|rtrim('/') }}/category{{ config.system.param_sep }}{{ category }}">{{ category }}</a>{{ dec_right|raw }}{{ not loop.last ? ',' : '' }}
    {% endfor %}</small>
  {% endif %}

  {# Children #}
  {% if cfg.show_children and inner_children|length > 0 %}
  {% set inner_children = inner_children.order(page.header.content.order.by|default(system.pages.order.by),
                                               page.header.content.order.dir|default(system.pages.order.dir)) %}
  <ul class="nested-children">
    {% for child in inner_children %}
      {% include 'partials/item/list.html.twig' with {'page':child, 'parent':parent, level:level + 1} %}
    {% endfor %}
    <br>
  </ul>
  {% endif %} {# End render nested children #}
</li>
{% endif %}