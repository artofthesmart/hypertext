{% import 'partials/item/image.html.twig' as image %}
{% import 'partials/item/fragments.html.twig' as fragments %}
{% set content_width = layout_cfg.width == 'full' ? 960 : layout_cfg.width|int %}
{% set thumb_size = (content_width / 16)|round %}

{% if page.isDir() %}
  <li><strong>{{ page.title }}</strong></li>
{% else %}
  <li class="child-level-{{ level }}{% if page.taxonomy.category %} {{ fragments.category_classes(page) }}{% endif %}">
    {% if cfg.image %}
      {{ image.render(page, 'thumbnail', thumb_size, thumb_size, 'lazy', page.url) }}
    {% endif %}

    {% if cfg.date != 'none' %}
      {{ dec_left|raw }}{{ fragments.date(page, cfg.date) }}{{ dec_right|raw }}
    {% endif %}

    {% if cfg.title %}
      {% if level == 1 %}<strong>{% endif %}<a href="{{ page.url }}">{{ page.title }}</a>{% if level == 1 %}</strong>{% endif %}
    {% endif %}
    {% if cfg.subtitle and page.header.subtitle %} – <small>{{ page.header.subtitle }}</small>{% endif %}

    {% if cfg.categories and page.taxonomy.category %}
      <br>{{ 'THEME_HYPERTEXT.CATEGORIES.CATEGORIES'|t }}:
      <small>{{ fragments.categories(page, parent.url, dec_left, dec_right) }}</small>
    {% endif %}
    {% if cfg.tags and page.taxonomy.tag %}
      <br>{{ 'THEME_HYPERTEXT.TAGS.TAGS'|t }}:
      <small>{{ fragments.tags(page, parent.url, dec_left, dec_right) }}</small>
    {% endif %}

    {% if collection_cfg.nested %}
      {% set inner_children = page.collection()|length > 0 ? page.collection() : page.children.visible %}
      {% if inner_children|length > 0 %}
        <ul class="nested-children">
        {% for child in inner_children %}
          {% set child_local = child.header.hypertext.content|default({})|filter(value => value != 'default') %}
          {% set child_cfg = display_cfg|merge(child_local) %}
          {% include 'partials/item/list.html.twig' with {
            'page': child,
            'parent': parent,
            'cfg': child_cfg,
            'collection_cfg': collection_cfg,
            'display_cfg': display_cfg,
            'level': level + 1
          } %}
        {% endfor %}
        </ul>
      {% endif %}
    {% endif %}
  </li>
{% endif %}
