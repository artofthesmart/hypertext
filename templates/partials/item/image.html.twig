{% macro render(page, kind, width = null, height = null, loading = 'lazy', href = null) %}
  {% set preferred = kind == 'header'
    ? page.header.header_image_file|default('')
    : page.header.thumbnail_image_file|default('') %}
  {% set image = preferred ? page.media.images[preferred]|default(null) : null %}

  {% if not image and kind == 'thumbnail' %}
    {% if page.media.images['thumbnail.webp'] is defined %}
      {% set image = page.media.images['thumbnail.webp'] %}
    {% elseif page.media.images['thumbnail.jpg'] is defined %}
      {% set image = page.media.images['thumbnail.jpg'] %}
    {% elseif page.media.images['thumbnail.png'] is defined %}
      {% set image = page.media.images['thumbnail.png'] %}
    {% elseif page.media.images['thumbnail.gif'] is defined %}
      {% set image = page.media.images['thumbnail.gif'] %}
    {% endif %}
  {% endif %}

  {% if not image %}
    {% if page.media.images['header.webp'] is defined %}
      {% set image = page.media.images['header.webp'] %}
    {% elseif page.media.images['header.jpg'] is defined %}
      {% set image = page.media.images['header.jpg'] %}
    {% elseif page.media.images['header.png'] is defined %}
      {% set image = page.media.images['header.png'] %}
    {% elseif page.media.images['header.gif'] is defined %}
      {% set image = page.media.images['header.gif'] %}
    {% elseif page.media.images|length > 0 %}
      {% set image = page.media.images|first %}
    {% endif %}
  {% endif %}

  {% if image %}
    {% set rendered = width and height ? image.cropZoom(width|round, height|round) : image %}
    {% if href %}<a href="{{ href }}">{% endif %}
    <img
      src="{{ rendered.url }}"
      width="{{ rendered.width }}"
      height="{{ rendered.height }}"
      loading="{{ loading }}"
      decoding="async"
      {% if loading == 'eager' %}fetchpriority="high"{% endif %}
      alt="{{ page.title|e('html_attr') }}">
    {% if href %}</a>{% endif %}
  {% endif %}
{% endmacro %}
